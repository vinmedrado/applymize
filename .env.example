APP_NAME=Applymize
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://applymize:applymize@db:5432/applymize
TEST_DATABASE_URL=sqlite:///./test_applymize.db
SECRET_KEY=local-dev-secret-change-me
REFRESH_SECRET_KEY=local-dev-refresh-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^http://(192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}):5173$
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_MIN_LENGTH=8
MATCH_WEIGHT_REQUIRED_SKILLS=0.35
MATCH_WEIGHT_DESIRED_SKILLS=0.20
MATCH_WEIGHT_SENIORITY=0.15
MATCH_WEIGHT_KEYWORD=0.15
MATCH_WEIGHT_SALARY=0.05
MATCH_WEIGHT_REMOTE_LOCATION=0.10
AUTO_SEED=false

APPLICATION_AGENT_DAILY_LIMIT=10

APPLICATION_AGENT_MIN_PROFILE_COMPLETENESS=35
STRATEGY_WEIGHT_MATCH=0.38
STRATEGY_WEIGHT_RECENCY=0.16
STRATEGY_WEIGHT_COMPETITION=0.14
STRATEGY_WEIGHT_LOCATION=0.10
STRATEGY_WEIGHT_REMOTE=0.10
STRATEGY_WEIGHT_SENIORITY=0.12

NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=applymize_local_key
EVOLUTION_INSTANCE_ID=
EVOLUTION_INSTANCE_PREFIX=applymize
EVOLUTION_DEFAULT_COUNTRY_CODE=55
WHATSAPP_ENABLED=true
NOTIFICATION_MAX_PER_RUN=5
NOTIFICATION_MIN_PRIORITY=HIGH

EVOLUTION_TARGET_NUMBER=

JOB_RADAR_ENABLED=false
JOB_RADAR_INTERVAL=24h

# Password reset / email
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Automation Scheduler (opt-in / Render safe)
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_LOOP_SECONDS=300
AUTOMATION_DEFAULT_INGEST_LIMIT=20
AUTOMATION_DEFAULT_PROVIDER=all
AUTOMATION_WHATSAPP_DELAY_SECONDS=2
AUTOMATION_MAX_NOTIFICATIONS_PER_RUN=5


# Applymize IA
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_ENABLED=true
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://host.docker.internal:11434
CAREER_AI_TIMEOUT_SECONDS=25
CAREER_AI_MAX_MESSAGE_CHARS=3000

# Timezone / search defaults
APP_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
AUTOMATION_DEFAULT_TERM=Analista de Dados
AUTOMATION_DEFAULT_CITY=São Paulo
AUTOMATION_DEFAULT_STATE=SP
AUTOMATION_DEFAULT_COUNTRY=Brazil
AUTOMATION_DEFAULT_INFOJOBS_CITY_CODE=5211323

# AI cost protection
LINKEDIN_ANALYZER_DAILY_LIMIT=3
CAREER_AI_DAILY_LIMIT=20
PUBLIC_AI_DEMO_ENABLED=false

# Billing / Stripe (opcional para produção)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_RECRUITER_MONTHLY=
